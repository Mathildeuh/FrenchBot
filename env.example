# Token de ton bot Discord (Portail développeur Discord > Bot > Reset Token)
DISCORD_TOKEN=

# ID du salon Discord où poster l'alerte (clic droit sur le salon > Copier l'ID, mode développeur activé)
CHANNEL_ID=

# Pseudo TikTok à surveiller, SANS le @
TIKTOK_USERNAME=frenchgameuse

# Clé API Euler Stream (https://www.eulerstream.com)
EULER_API_KEY=

# ID du serveur Discord (optionnel). Si défini, la commande /prochain-stream est enregistrée
# sur ce serveur (dispo instantanément). Sinon elle est enregistrée en global (jusqu'à 1h de délai
# la première fois).
GUILD_ID=
